# ---- Telegram ----
# @BotFather -> /newbot -> copy the token. The bot's username must end in "bot".
TELEGRAM_BOT_TOKEN=

# ---- LLM (any OpenAI-compatible endpoint) ----
# OpenAI:   base=https://api.openai.com/v1
# AI Pipe:  base=https://aipipe.org/openai/v1   (IITM TDS token)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Hosting ----
# Public HTTPS base of THIS app, no trailing slash - used to build log_url.
# e.g. https://your-app.onrender.com   (locally, leave the default)
PUBLIC_BASE_URL=http://localhost:8000
PORT=8000

# Optional: how many LLM<->tool steps the agent may take per question.
AGENT_MAX_STEPS=8
